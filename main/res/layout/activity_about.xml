<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFF5FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- BACK BUTTON -->
        <ImageView
            android:id="@+id/btnBackAbout"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true" />

        <!-- HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✈  GET TO KNOW US"
            android:textColor="#2878D0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Travel smarter,\ntravel happier"
            android:textColor="#173B70"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="A little tool to make your journey easier."
            android:textColor="#70839D"
            android:textSize="14sp" />

        <!-- LUGGAGE IMAGE -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/luggage"
            android:scaleType="fitCenter"
            android:contentDescription="Travel luggage illustration" />

        <!-- ABOUT CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="About the app"
                android:textColor="#173B70"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Baggage Fee Calculator helps travellers estimate excess baggage charges based on baggage weight, ticket class and rate per kilogram. The total includes an 8% tax."
                android:textColor="#647890"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

        <!-- DEVELOPER CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👩‍💻  Developer Information"
                android:textColor="#173B70"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeveloperName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Developer: nurul ainsyah binti ghazali"
                android:textColor="#425A78"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvStudentId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Student ID: 2024690044"
                android:textColor="#425A78"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvProgramme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Programme Code: CDCS240"
                android:textColor="#425A78"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Group: 5B"
                android:textColor="#425A78"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnWebsite"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#2878D0"
                android:text="Visit Website  ↗"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- COPYRIGHT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="© 2026 Baggage Fee Calculator.\nAll rights reserved."
            android:textColor="#8292A8"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="HAVE A SAFE AND HAPPY JOURNEY ✈"
            android:textColor="#6482A7"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
